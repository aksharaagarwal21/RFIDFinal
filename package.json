{
  "name": "rfid-workspace",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "serve": "set NODE_ENV=production&& cd backend && npm start"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
